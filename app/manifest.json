{
  "manifestVersion": 2,
  "id": "comfyui-hana",
  "name": "ComfyUI-Hana",
  "version": "0.2.0",
  "description": "把本机 ComfyUI（127.0.0.1:8188）接进 Hana：整页工作区内嵌官方前端，经受管中继提供 HTTP/WS 通道与状态面（v0 骨架）。",
  "entry": "index.js",
  "icon": "assets/icon.png",
  "minAppVersion": "0.1013.0",
  "network": {
    "allowedHosts": [
      "127.0.0.1"
    ],
    "methods": [
      "GET"
    ],
    "allowLocalhost": true,
    "defaultTimeoutMs": 5000,
    "maxResponseBytes": 1048576
  },
  "capabilities": [
    "app/runtime.execute",
    "app/runtime.local-machine",
    "app/runtime.network",
    "app/tools.expose-to-model",
    "app/tasks.manage",
    "app/session.start-turn"
  ],
  "contributes": {
    "cards": [
      {
        "id": "workspace",
        "title": "ComfyUI 工作区",
        "description": "整页工作区：经宿主代理路径内嵌 ComfyUI 官方前端（零改造，相对寻址）",
        "route": "/workspace.html",
        "realization": "page",
        "siteNavEntry": true,
        "fpFullPanel": true,
        "closable": false,
        "cardForm": "flush",
        "titlebar": "solid",
        "functionPanel": {
          "id": "status",
          "label": "ComfyUI 状态",
          "route": "/panel.html"
        },
        "detached": {
          "route": "/workspace.html"
        },
        "face": {
          "image": "assets/cover.png"
        }
      },
      {
        "id": "task",
        "title": "ComfyUI 任务卡",
        "description": "单次生成任务的进度卡：状态/队列位/耗时/产物缩略（数据经 /comfyui-hana/task 路由）",
        "route": "/task.html",
        "cardForm": "flush",
        "face": {
          "image": "assets/cover.png"
        }
      }
    ],
    "settings": {
      "title": "ComfyUI-Hana",
      "ui": {
        "route": "/settings.html"
      }
    }
  }
}
